# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Staff login: choose a strong PIN/password, then set STAFF_PASSWORD_HASH to its bcrypt hash.
# Generate a hash with: node -e "require('bcryptjs').hash('your-password', 12).then(console.log)"
STAFF_PASSWORD_HASH=
STAFF_SESSION_SECRET=

# Public URL used by QR codes, canonical metadata and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
